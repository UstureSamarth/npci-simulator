<?xml version='1.0'?>
<!DOCTYPE SYSTEM []>

<txnmgr class="org.jpos.transaction.TransactionManager" logger="Q2" realm="txn-mgr">
    <property name="queue" value="TXNMGR"/>
    <property name="sessions" value="${TXNMGR_SESSION}"/>
    <property name="max-sessions" value="${TXNMGR_MAX_SESSION}"/>
    <property name="debug" value="true"/>

    <participant class="org.jpos.qrest.participant.Router">
        <route path="/aeps/{reqName}/2.0/urn:txnid:{txn}" method="POST"/>
    </participant>

    <participant class="com.sarvatra.sim.ParseRequest"/>
    <participant class="com.sarvatra.sim.CreateAck"/>
    <participant class="org.jpos.qrest.SendResponse"/>
    <participant class="org.jpos.transaction.participant.Switch">
        <property name="txnname" value="PREPARE_RESPONSE"/>
        <property name="Y" value="prepare-response"/>
    </participant>

    <group name="prepare-response">
        <participant class="com.sarvatra.sim.PrepareResponse"/>
        <participant class="com.sarvatra.sim.SendFinalResponse"/>
    </group>

</txnmgr>
